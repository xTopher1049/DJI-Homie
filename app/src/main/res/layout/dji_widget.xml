<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">
    <TextView android:id="@+id/w_title"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="DJI Power" android:textColor="#FFFFFF"
        android:textStyle="bold" android:textSize="13sp" />
    <TextView android:id="@+id/w_batt"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="--%" android:textColor="#5DD57B" android:textSize="26sp"
        android:textStyle="bold" />
    <TextView android:id="@+id/w_flow"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="0W out · 0W in" android:textColor="#CCCCCC" android:textSize="13sp" />
    <TextView android:id="@+id/w_rt"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="" android:textColor="#9AA0A6" android:textSize="11sp" />
</LinearLayout>
